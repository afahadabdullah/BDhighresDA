# data is large and, for BMD gauges, not redistributable
# NOTE: leading slash -- otherwise this would also ignore src/bdhires/data/
/data/
!/data/.gitkeep
# Derived station observations and diagnostics also stay local.
/output/bwdb_analysis/
/runs/
/results/
/logs/
*.zarr/
*.nc
*.nc4
*.npz
*.pt
*.ckpt

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
.env
.DS_Store
*.pdf

# Manuscript sources, review notes, and compiled submission artifacts stay local.
/manuscript/
.commit-msg.txt
